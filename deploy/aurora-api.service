# Aurora Site API 的 systemd 单元示例
#
# 用法：
#   1. 复制到 /etc/systemd/system/aurora-api.service，按实际路径与用户修改
#   2. 按 deploy/aurora-api.env.example 准备 /etc/aurora-api.env
#   3. systemctl daemon-reload && systemctl enable --now aurora-api

[Unit]
Description=Aurora Site API (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/my_website/api
EnvironmentFile=-/etc/aurora-api.env
ExecStart=/opt/my_website/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

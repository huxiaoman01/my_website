# 复制到 /etc/aurora-api.env 后按需修改；未设置的变量使用默认值。
# 生产环境由 Nginx 托管静态文件，因此一般只需要数据库与项目数据的位置。

AURORA_PROJECTS_FILE=/opt/my_website/api/data/projects.json
AURORA_MESSAGES_DB=/opt/my_website/api/data/messages.db

# 前端独立部署在其他来源时才需要（逗号分隔）
# AURORA_CORS_ORIGINS=https://example.com

# /api/messages 单次返回的留言条数上限
AURORA_MESSAGES_LIMIT=50
